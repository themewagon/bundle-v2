        ul.list-no-disc.mb-7.mb-md-8.mb-lg-9.fs--1.fs-md-0.fs-xl-1.d-flex.align-items-center.gap-sm.gap-md-5.gap-xl-16.justify-content-center.text-white.flex-column.flex-md-row
          li.d-flex.align-items-center 
            .list-bullet 
            p.mb-0
              span.fw-semi-bold Unlimited Use 
              s  $1828
              span.text-success.fw-bold  $249 
          li.d-flex.align-items-center 
            .list-bullet 
            p.mb-0 
              span.fw-semi-bold Standard Plus 
              s  $1148
              span.text-success.fw-bold  $139 
        a.text-decoration(href="https://themewagon.com/themes/bundle-v2/" target="_blank")
          button.btn.btn-success.px-6.py-2.px-md-13.py-md-4 Purchase now 
    .position-absolute.bottom-0.start-0.end-0.z-n1.min-w-100
      img.img-fluid.object-fit-cover.w-100(src=`${CWD}assets/img/shape.svg`, alt="")
    .position-absolute.start-0.end-0.wave.w-100.z-1
      img.img-fluid.object-fit-cover.w-100(src=`${CWD}assets/img/wave.svg`, alt="")







